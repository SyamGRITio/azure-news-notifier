# FoundryのAzure OpenAI接続先（/openai/v1などのパスは付けない）
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# Portalで作成したモデルの「デプロイ名」
FOUNDRY_DEPLOYMENT=gpt-5-nano
# Slack Incoming WebhookのURL。Botトークンとは異なる
SLACK_WEBHOOK_URL=

# 通常配信の開始日時。タイムゾーン付きISO形式で指定し、毎日は変更しない。
# 例: 2026-11-16T00:00:00+09:00（未設定なら通常配信は停止）
DELIVERY_START_AT=
